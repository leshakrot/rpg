--- !u!114 &-4997813797341376164
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: 7f0a3c9a-c065-4663-9cb6-08a736f0246f
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u0421\u0443\u043D\u0434\u0443\u043A, \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C?
    \u0425\u0430, \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E.\n\u041C\u044B
    \u043D\u0435 \u0432\u043E\u0434\u043E\u043B\u0430\u0437\u044B, \u043F\u0430\u0440\u0435\u043D\u044C.
    \u041D\u043E...\n\u0415\u0441\u0442\u044C \u0441\u0442\u0430\u0440\u044B\u0439
    \u043F\u043E\u0434\u044A\u0435\u043C\u043D\u0438\u043A. \u041C\u0435\u0445\u0430\u043D\u0438\u043A\u0430
    \u043F\u0440\u043E\u0441\u0442\u0430\u044F, \u043D\u043E \u043C\u043E\u0449\u043D\u0430\u044F.\n\u0422\u043E\u043B\u044C\u043A\u043E
    \u0432\u043E\u0442 \u043E\u043D \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0432
    \u0448\u0430\u0445\u0442\u0435 \u2014 \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u043E
    \u0442\u0430\u043C \u0432\u0441\u0451. \u0414\u0430 \u0438 \u043E\u043F\u0430\u0441\u043D\u043E
    \u0442\u0443\u0434\u0430 \u0441\u0443\u043D\u0443\u0442\u044C\u0441\u044F.\n\u041D\u043E
    \u0435\u0441\u043B\u0438 \u0431\u044B \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
    \u0441\u043C\u043E\u0433 \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C
    \u043F\u0443\u0442\u044C, \u0433\u043B\u044F\u0434\u0438\u0448\u044C - \u0438
    \u0441\u0443\u043D\u0434\u0443\u043A \u0442\u0432\u043E\u0439 \u0434\u043E\u0441\u0442\u0430\u043B\u0438
    \u0431\u044B."
  children:
  - 0f9f6623-f48b-44d7-bb28-8c9bd10dc799
  - c690e4ee-c1d2-4e48-8ce4-4598cb348100
