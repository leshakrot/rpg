  m_Name: GiveDirections
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041E\u0434\u0438\u043D \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0432 \u041F\u0435\u0449\u0435\u0440\u0435
    \u0422\u0435\u043D\u0435\u0439 \u043D\u0430 \u0441\u0435\u0432\u0435\u0440\u0435,
    \u0432\u0442\u043E\u0440\u043E\u0439 - \u0432 \u0417\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u043C
    \u043B\u0435\u0441\u0443 \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A\u0435,
    \u0430 \u0442\u0440\u0435\u0442\u0438\u0439 \u0441\u043F\u0440\u044F\u0442\u0430\u043D
    \u0432 \u0414\u0440\u0435\u0432\u043D\u0438\u0445 \u0440\u0443\u0438\u043D\u0430\u0445
    \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u0435. \u0411\u0443\u0434\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D,
    \u044D\u0442\u0438 \u043C\u0435\u0441\u0442\u0430 \u043D\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B."
  children: []
  rect:
    serializedVersion: 2
    x: 1250
    y: 0
    width: 200
    height: 100
  onEnterActions: []
  onExitActions: []
  condition:
    _and: []
