  m_Name: ExplainAmulet
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0434\u0440\u0435\u0432\u043D\u0438\u0439
    \u0430\u043C\u0443\u043B\u0435\u0442 \u0441 \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0439
    \u0441\u0438\u043B\u043E\u0439. \u041D\u043E \u043F\u0440\u0435\u0436\u0434\u0435
    \u0447\u0435\u043C \u044F \u0441\u043C\u043E\u0433\u0443 \u0435\u0433\u043E \u043F\u0440\u043E\u0434\u0430\u0442\u044C,
    \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
    \u0442\u0440\u0438 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430 \u0434\u043B\u044F \u0435\u0433\u043E
    \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438. \u041F\u043E\u043C\u043E\u0436\u0435\u0448\u044C?"
