  m_Name: NewQuest
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u042F - \u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
    \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044F\u043C\u0438.
    \u0423 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u043A\u043E\u0435-\u0447\u0442\u043E
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0435... \u0435\u0441\u043B\u0438
    \u0442\u044B \u0433\u043E\u0442\u043E\u0432 \u043F\u043E\u043C\u043E\u0447\u044C."
  children:
  - 
  - 
  - AskAboutItem
  - Decline
  rect:
    serializedVersion: 2
    x: 250
    y: 0
    width: 200
    height: 100
  onEnterActions: []
  onExitActions: []
