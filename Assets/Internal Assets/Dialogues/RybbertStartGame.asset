  isPlayerSpeaking: 0
  text: "\u041B\u0430\u0434\u043D\u043E, \u0440\u044B\u0431\u044B \u043C\u044B \u043D\u0430\u0442\u0430\u0441\u043A\u0430\u043B\u0438
    \u0441\u0442\u043E\u043B\u044C\u043A\u043E, \u0447\u0442\u043E \u043D\u0430 \u0432\u0441\u044E
    \u0434\u0435\u0440\u0435\u0432\u043D\u044E \u0445\u0432\u0430\u0442\u0438\u0442.
    \u0422\u044B \u043A\u0430\u043A \u0445\u043E\u0447\u0435\u0448\u044C, \u0430
    \u044F \u043F\u043E\u0439\u0434\u0443 \u0441\u043F\u0430\u0442\u044C. \u0417\u0430\u0432\u0442\u0440\u0430
    \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A, \u0431\u0443\u0434\u0435\u0442
    \u0432\u0435\u0441\u0435\u043B\u043E!"
