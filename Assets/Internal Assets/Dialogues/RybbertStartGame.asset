  isPlayerSpeaking: 0
  text: "\u0414\u0430 \u0432\u044B\u0434\u0443\u043C\u043A\u0438 \u044D\u0442\u043E
    \u0432\u0441\u0435, \u043D\u043E \u0435\u0441\u043B\u0438 \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u043D\u043E,
