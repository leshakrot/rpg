  m_EditorClassIdentifier: Assembly-CSharp::RPG.Dialogue.DialogueNode
  isPlayerSpeaking: 0
  text: "\u041F\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044E\u0442,
    \u043A\u043E\u0433\u0434\u0430 \u043D\u0435\u0431\u043E \u0442\u0430\u043A\u043E\u0435
    \u0436\u0435 \u044F\u0440\u043A\u043E\u0435 \u043A\u0430\u043A \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    - \u0434\u0443\u0445 \u044D\u0442\u043E\u0433\u043E \u043E\u0437\u0435\u0440\u0430
    \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u0442\u0435\u043C\u0438,
    \u043A\u0442\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0436\u0430\u0434\u0435\u043D
    \u0432 \u0441\u0432\u043E\u0438\u0445 \u0436\u0435\u043B\u0430\u043D\u0438\u044F\u0445.
    \u0421\u043A\u0430\u0437\u043A\u0438 \u0432\u0441\u0451 \u044D\u0442\u043E, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
    \u044F \u0432 \u0442\u0430\u043A\u043E\u0435 \u043D\u0435 \u0432\u0435\u0440\u044E."
