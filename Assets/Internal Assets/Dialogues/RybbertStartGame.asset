  isPlayerSpeaking: 0
  text: "\u0425\u043E\u0442\u044F... \u0431\u043E\u043B\u0442\u0430\u043B\u0438,
    \u0431\u0443\u0434\u0442\u043E \u043C\u0435\u043B\u044C\u043D\u0438\u043A \u043E\u0434\u043D\u0430\u0436\u0434\u044B
