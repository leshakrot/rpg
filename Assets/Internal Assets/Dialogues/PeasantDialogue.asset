    \u0447\u0442\u043E \u0438\u0445 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442,
    \u0437\u043D\u0430\u0447\u0438\u0442, \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0430
    \u0440\u0435\u0448\u0435\u043D\u0430. \u0421\u043F\u0430\u0441\u0438\u0431\u043E
