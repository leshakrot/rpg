  isPlayerSpeaking: 0
  text: "\u0410\u0445, \u0434\u0440\u0443\u0436\u0438\u0449\u0435, \u0431\u0435\u0434\u0430
    \u0443 \u043C\u0435\u043D\u044F! \u0417\u0430\u0432\u0442\u0440\u0430 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A
