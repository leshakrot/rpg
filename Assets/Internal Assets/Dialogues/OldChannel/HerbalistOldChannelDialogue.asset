  m_EditorClassIdentifier: Assembly-CSharp::RPG.Dialogue.DialogueNode
  isPlayerSpeaking: 1
  text: "Что это за вода?"
  children:
  - 0de11de7-bc91-40d4-9d75-9c80d47df74a
  rect:
    serializedVersion: 2
    x: 250
    y: 80
    width: 200
