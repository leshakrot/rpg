  m_EditorClassIdentifier: Assembly-CSharp::RPG.Dialogue.DialogueNode
  isPlayerSpeaking: 0
  text: "Договорились. Только не тащи первое зелёное растение, которое увидишь. Здесь хватает похожих. Мне нужны именно те, о которых я сказал."
  children: []
  rect:
    serializedVersion: 2
    x: 2000
    y: 230
    width: 200
    height: 100
  onEnterActions: []
  onExitActions: []
  condition:
