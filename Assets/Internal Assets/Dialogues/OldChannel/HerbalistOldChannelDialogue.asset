  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: 211f6849-c975-411b-b1db-686f08279227
  m_EditorClassIdentifier: Assembly-CSharp::RPG.Dialogue.DialogueNode
  isPlayerSpeaking: 0
  text: "**Травник на секунду отрывается от котла, смотрит на героя и вытирает руки о фартук.**\nЕсли ты просто проходишь мимо — проходи. Если пришёл за зельем — придётся подождать. Если пришёл с травами — вот это уже другое дело."
  children:
  - a9ae8a02-a978-472e-823a-6b7c87cd2a8a
  - b3dee901-006b-485d-ae3d-7504bc423919
  - 3c5aee05-ef10-4d85-b002-707e95f3052b
  - ae927a5a-eecd-4eb8-ac47-700b023d67ae
  rect:
    serializedVersion: 2
    x: 0
    y: 0
    width: 200
    height: 100
  onEnterActions: []
  onExitActions: []
  condition:
    _and: []

--- !u!114 &-8999999999999999999
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
