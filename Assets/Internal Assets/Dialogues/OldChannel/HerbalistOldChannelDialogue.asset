MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: "a8c1c1f5-1dd2-4b26-aeab-71a06e256c65"
  m_EditorClassIdentifier: Assembly-CSharp::RPG.Dialogue.DialogueNode
  isPlayerSpeaking: 0
  text: "Готовое зелье, когда закончу. И можешь считать это оплатой за то, что избавишь меня от необходимости бросать котёл и тащиться по лесу самому."
  children:
  - 1676fcdc-92ad-4617-b6bc-9c8ef1ea356c
  rect:
    serializedVersion: 2
    x: 1500
    y: 230
    width: 200
    height: 100
  onEnterActions: []
  onExitActions: []
  condition:
    _and: []

