    _and: []

--- !u!114 &-8999999999999999996
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: "ae927a5a-eecd-4eb8-ac47-700b023d67ae"
  m_EditorClassIdentifier: Assembly-CSharp::RPG.Dialogue.DialogueNode
  isPlayerSpeaking: 1
  text: "Тебе что-нибудь нужно?"
  children:
  - 99764c60-e443-444b-9891-756bfeb6377d
  rect:
    serializedVersion: 2
    x: 250
    y: 230
    width: 200
    height: 100
