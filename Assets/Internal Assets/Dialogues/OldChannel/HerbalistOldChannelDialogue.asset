  m_EditorClassIdentifier: Assembly-CSharp::RPG.Dialogue.DialogueNode
  isPlayerSpeaking: 1
  text: "Ты здесь один живёшь?"
  children:
  - 5c29b7f5-5a6b-4c85-bad5-e636c7ad7230
  rect:
    serializedVersion: 2
    x: 250
    y: -220
    width: 200
