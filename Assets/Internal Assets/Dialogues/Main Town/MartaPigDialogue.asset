  m_Name: marta03-4567-89ab-cdef-123456789012
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041f\u043e\u0440\u043e\u0441\u0435\u043d\u043e\u043a \u043c\u043e\u0439! \u041b\u0443\u0447\u0448\u0438\u0439 \u0432 \u043f\u043e\u043c\u0435\u0442\u0435! \u0425\u043e\u0442\u0435\u043b\u0430 \u043a \u043f\u0440\u0430\u0437\u0434\u043d\u0438\u043a\u0443 \u0435\u0433\u043e \u043f\u0440\u043e\u0434\u0430\u0442\u044c, \u0430 \u043e\u043d \u0431\u0443\u0434\u0442\u043e \u043f\u043e\u0447\u0443\u044f\u043b, \u0438 \u0441\u0438\u0433\u0430\u043d\u0443\u043b \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u0431\u043e\u0440. \u0415\u0441\u043b\u0438 \u0435\u0433\u043e \u0432\u043e\u043b\u043a\u0438 \u0432 \u043b\u0435\u0441\u0443 \u0443\u0442\u0430\u0449\u0430\u0442, \u044f \u0440\u0430\u0437\u043e\u0440\u0435\u043d\u0430! \u041f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430, \u043f\u043e\u0438\u0449\u0438 \u0435\u0433\u043e \u0432 \u043e\u0432\u0440\u0430\u0433\u0435 \u0437\u0430 \u0441\u0430\u0440\u0430\u044f\u043c\u0438, \u0430? \u042f \u0437\u0430\u043f\u043b\u0430\u0447\u0443, \u0447\u0435\u043c \u0441\u043c\u043e\u0433\u0443!"
