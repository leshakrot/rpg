  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041F\u0440\u0430\u0437\u0434\u043D\u0438\u043A \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F,
    \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C. \u0417\u0430\u0445\u043E\u0434\u0438,
    \u0435\u0441\u043B\u0438 \u043D\u0430\u0434\u0443\u043C\u0430\u0435\u0448\u044C
    \u043F\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u2014 \u0443
    \u043C\u0435\u043D\u044F \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F \u043A\u043E\u0435-\u0447\u0442\u043E
    \u0435\u0449\u0451. *\u0423\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F \u0447\u0443\u0442\u044C
    \u0448\u0438\u0440\u0435, \u0447\u0435\u043C \u043D\u0443\u0436\u043D\u043E*"
