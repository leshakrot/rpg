  m_Name: djinn-root
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041E-\u043E-\u043E! \u0412\u043E\u0442 \u044D\u0442\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B!
    \u042F \u043E\u0431\u044A\u0435\u0445\u0430\u043B \u043D\u0435\u043C\u0430\u043B\u043E
    \u044F\u0440\u043C\u0430\u0440\u043E\u043A, \u043D\u043E \u0442\u0430\u043A\u043E\u0433\u043E
    \u043C\u0435\u0442\u043A\u043E\u0433\u043E \u0441\u0442\u0440\u0435\u043B\u043A\u0430
    \u2014 \u0434\u0430\u0432\u043D\u0435\u043D\u044C\u043A\u043E \u043D\u0435 \u0432\u0438\u0434\u044B\u0432\u0430\u043B!
    \u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C,
    \u043F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C. \u042F \u0436\u0434\u0430\u043B
    \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u0435\u0431\u044F."
