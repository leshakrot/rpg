  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: GjinnMerchant
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u0420\u0430\u0437\u0443\u043C\u0435\u0435\u0442\u0441\u044F! \u0421\u043B\u043E\u0432\u043E
    \u043A\u0443\u043F\u0446\u0430 \u2014 \u043A\u0440\u0435\u043F\u0447\u0435 \u0437\u0430\u043C\u043A\u0430.
    \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u0442 \u043D\u0430\u0433\u0440\u0430\u0434\u0430
    \u0443 \u043C\u0435\u043D\u044F... \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u0430\u044F.
    \u041D\u0435 \u0437\u043E\u043B\u043E\u0442\u043E, \u043D\u0435 \u0431\u0435\u0437\u0434\u0435\u043B\u0443\u0448\u043A\u0430
    \u2014 \u043D\u0435\u0442. \u042F \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E
    \u0442\u0435\u0431\u0435 \u0432\u044B\u0431\u043E\u0440. \u0422\u0440\u0438 \u0434\u0430\u0440\u0430.
    \u041E\u0434\u0438\u043D \u2014 \u0442\u0432\u043E\u0439. \u0412\u044B\u0431\u0438\u0440\u0430\u0439
    \u043C\u0443\u0434\u0440\u043E, \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u044C."
  children:
  - djinn-p-gold
  - djinn-p-luck
  - djinn-p-surprise
