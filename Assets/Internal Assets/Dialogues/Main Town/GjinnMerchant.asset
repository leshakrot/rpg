  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: djinn-surprise-resp
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "*\u0413\u043B\u0430\u0437\u0430 \u043A\u0443\u043F\u0446\u0430 \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u044E\u0442
    \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u043C \u043E\u0433\u043D\u0451\u043C*
    \u0412\u043E\u0442 \u044D\u0442\u043E \u043E\u0442\u0432\u0435\u0442! \u041B\u0443\u0447\u0448\u0438\u0439
    \u0438\u0437 \u0442\u0440\u0451\u0445, \u043F\u043E\u0432\u0435\u0440\u044C \u043C\u043D\u0435.
    \u0422\u043E\u0442, \u043A\u0442\u043E \u043D\u0435 \u0446\u0435\u043F\u043B\u044F\u0435\u0442\u0441\u044F
    \u0437\u0430 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u043E\u0435 \u0436\u0435\u043B\u0430\u043D\u0438\u0435
    \u2014 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043D\u0435\u0447\u0442\u043E...
    \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0435. *\u041F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
    \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u0432\u0451\u0440\u0442\u043E\u043A*
    \u0427\u0442\u043E \u0432\u043D\u0443\u0442\u0440\u0438 \u2014 \u0443\u0437\u043D\u0430\u0435\u0448\u044C
    \u0441\u0430\u043C. \u0421\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C.
    \u0422\u0430\u043A\u0438\u0435 \u0432\u0435\u0449\u0438 \u043D\u0435 \u0441\u0442\u043E\u0438\u0442
    \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u044C."
  children:
  - djinn-end
  rect:
    serializedVersion: 2
    x: 1800
    y: 200
    width: 200
    height: 100
