  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "*\u0414\u0436\u0438\u043D \u0442\u0438\u0445\u043E \u0441\u043C\u0435\u0451\u0442\u0441\u044F,
    \u043E\u0442\u043A\u0438\u0434\u044B\u0432\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u0443*
    \u0428\u0438\u0440\u043E\u043A\u043E \u0437\u0430\u0433\u0440\u0435\u0431\u0430\u0435\u0448\u044C,
    \u0441\u043C\u043E\u0442\u0440\u0438 \u2014 \u0441\u0435\u0442\u044C \u043F\u043E\u0440\u0432\u0451\u0442\u0441\u044F!
    \u041D\u0443 \u0447\u0442\u043E \u0436. \u0428\u0438\u0440\u043E\u043A\u043E\u0435
    \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u2014 \u0448\u0438\u0440\u043E\u043A\u0430\u044F
    \u0446\u0435\u043D\u0430. \u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F
    \u2014 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A, \u044F \u0434\u043E\u0431\u0440\u044B\u0439.
    *\u041F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0439
    \u0430\u043C\u0443\u043B\u0435\u0442 \u043D\u0430 \u0442\u0451\u043C\u043D\u043E\u043C
    \u0448\u043D\u0443\u0440\u043A\u0435* \u041D\u043E\u0441\u0438. \u0423\u0434\u0430\u0447\u0430
    \u2014 \u043E\u043D\u0430 \u043B\u044E\u0431\u0438\u0442 \u0442\u0435\u0445,
    \u043A\u0442\u043E \u043D\u0435 \u0431\u043E\u0438\u0442\u0441\u044F \u043F\u0440\u043E\u0441\u0438\u0442\u044C."
