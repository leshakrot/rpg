  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: djinn-whoareyou-resp
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041A\u0443\u043F\u0435\u0446. \u0421\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439.
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u2014 \u0437\u0434\u0435\u0441\u044C,
    \u0437\u0430\u0432\u0442\u0440\u0430 \u2014 \u0437\u0430 \u0433\u043E\u0440\u0430\u043C\u0438.
    \u0422\u0430\u043A\u043E\u0432\u0430 \u0434\u043E\u043B\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. *\u0420\u0430\u0437\u0432\u043E\u0434\u0438\u0442
    \u0440\u0443\u043A\u0430\u043C\u0438 \u0441 \u043C\u044F\u0433\u043A\u043E\u0439
    \u0443\u043B\u044B\u0431\u043A\u043E\u0439* \u041D\u043E \u043F\u043E\u043A\u0430
    \u044F \u0437\u0434\u0435\u0441\u044C \u2014 \u043A \u0432\u0430\u0448\u0438\u043C
    \u0443\u0441\u043B\u0443\u0433\u0430\u043C. \u0420\u0435\u0434\u043A\u0438\u0435
    \u0442\u043E\u0432\u0430\u0440\u044B, \u0440\u0435\u0434\u043A\u0438\u0435 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438."
  children:
  - djinn-p-wheregoods
  - djinn-p-reward
