  m_Name: djinn-wheregoods-resp
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "*\u041A\u0443\u043F\u0435\u0446 \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
    \u043F\u0430\u043B\u0435\u0446 \u043A \u0433\u0443\u0431\u0430\u043C* \u041F\u0440\u043E\u0441\u0442\u043E\u0433\u043E?
    \u042D\u0442\u043E \u0442\u044B \u0437\u0440\u044F. \u042F \u0442\u043E\u0440\u0433\u0443\u044E
    \u0442\u0435\u043C, \u0447\u0442\u043E \u0434\u0440\u0443\u0433\u0438\u043C \u043D\u0435
    \u043D\u0430\u0439\u0442\u0438. \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0443
    \u043C\u0435\u043D\u044F \u043E\u0441\u043E\u0431\u044B\u0439 \u043D\u044E\u0445
    \u043D\u0430... \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438. *\u041D\u0430\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F
    \u0447\u0443\u0442\u044C \u0432\u043F\u0435\u0440\u0451\u0434, \u0433\u043E\u043B\u043E\u0441
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0442\u0438\u0448\u0435*
    \u041D\u043E \u0445\u0432\u0430\u0442\u0438\u0442 \u043E\u0431\u043E \u043C\u043D\u0435.
    \u0422\u044B \u0432\u0435\u0434\u044C \u043F\u0440\u0438\u0448\u0451\u043B \u043D\u0435
    \u0437\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044F\u043C\u0438 \u2014 \u0437\u0430
    \u043D\u0430\u0433\u0440\u0430\u0434\u043E\u0439. \u0412\u0435\u0440\u043D\u043E?"
