  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: djinn-gold-resp
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u0425\u0430! \u041F\u0440\u044F\u043C\u043E \u0438 \u0431\u0435\u0437 \u0437\u0430\u0442\u0435\u0439
    \u2014 \u043B\u044E\u0431\u043B\u044E \u0442\u0430\u043A\u0438\u0445! \u041C\u043E\u043D\u0435\u0442\u044B
    \u2014 \u044D\u0442\u043E \u044F \u043C\u043E\u0433\u0443. *\u0414\u043E\u0441\u0442\u0430\u0451\u0442
    \u0442\u044F\u0436\u0451\u043B\u044B\u0439 \u043A\u043E\u0448\u0435\u043B\u044C
    \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0441
    \u043B\u0451\u0433\u043A\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u043E\u0439*
    \u041D\u043E \u043F\u043E\u043C\u043D\u0438, \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u044C:
    \u0431\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u043E \u2014 \u043E\u043D\u043E
    \u0440\u0430\u0437\u043D\u043E\u0435 \u0431\u044B\u0432\u0430\u0435\u0442. \u0418\u043D\u043E\u0435
    \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u0438\u0442, \u0438\u043D\u043E\u0435...
    \u0436\u0436\u0451\u0442."
  children:
  - djinn-end
