  m_Name: djinn-unfair-resp
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "*\u041A\u0443\u043F\u0435\u0446 \u0432\u0441\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442
    \u0431\u0440\u043E\u0432\u0438 \u0441 \u043F\u0440\u0438\u0442\u0432\u043E\u0440\u043D\u044B\u043C
    \u0438\u0437\u0443\u043C\u043B\u0435\u043D\u0438\u0435\u043C* \u041D\u0435\u0447\u0435\u0441\u0442\u043D\u043E?!
    \u0414\u0430 \u044F \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E
    \u0442\u0430\u043A \u0437\u0430\u0434\u0443\u043C\u0430\u043B! \u041B\u044E\u0431\u043E\u0439
    \u0434\u0443\u0440\u0430\u043A \u043F\u043E\u043F\u0430\u0434\u0451\u0442 \u0432
    \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u0443\u044E \u043C\u0438\u0448\u0435\u043D\u044C.
    \u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u0431\u044B\u043B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
    \u0441\u0442\u0440\u0435\u043B\u043E\u043A. \u0418 \u0442\u044B \u0438\u043C
    \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F. \u0422\u0430\u043A \u0447\u0442\u043E
    \u2014 \u043D\u0435 \u0436\u0430\u043B\u0443\u0439\u0441\u044F, \u0430 \u043F\u043E\u043B\u0443\u0447\u0430\u0439
    \u0437\u0430\u0441\u043B\u0443\u0436\u0435\u043D\u043D\u043E\u0435!"
