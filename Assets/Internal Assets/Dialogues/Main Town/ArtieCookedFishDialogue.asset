--- !u!114 &-6043357658433147896
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: 7aececbf-fada-47f1-9f7e-fbbaa05c968b
  m_EditorClassIdentifier: Assembly-CSharp::RPG.Dialogue.DialogueNode
  isPlayerSpeaking: 0
  text: "\u041E, \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E, \u044D\u0442\u043E
    \u0442\u043E \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E! \u0412\u043E\u0442,
    \u0434\u0435\u0440\u0436\u0438. \u0427\u0435\u0441\u0442\u043D\u0430\u044F \u043F\u043B\u0430\u0442\u0430
    \u0437\u0430 \u0447\u0435\u0441\u0442\u043D\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443!
    \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0433\u043E\u0442\u043E\u0432\u043B\u044E
    \u043C\u043E\u044E \u0444\u0438\u0440\u043C\u0435\u043D\u043D\u0443\u044E \u0440\u044B\u0431\u043D\u0443\u044E
    \u0448\u0430\u0443\u0440\u043C\u0443! *\u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442*
    \u0417\u043D\u0430\u0435\u0448\u044C, \u044F \u0433\u043E\u0442\u043E\u0432\u043B\u044E
    \u0432 \u044D\u0442\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u0443\u0436\u0435
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438
    \u043B\u0435\u0442. \u041A\u0430\u0436\u0434\u044B\u0439 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A
    \u043E\u0434\u043D\u043E \u0438 \u0442\u043E \u0436\u0435 - \u043F\u0438\u0440\u043E\u0433\u0438,
    \u0440\u0430\u0433\u0443, \u0440\u044B\u0431\u043D\u0430\u044F \u0448\u0430\u0443\u0440\u043C\u0430...
    \u041B\u044E\u0434\u0438 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B, \u043A\u043E\u043D\u0435\u0447\u043D\u043E,
    \u043D\u043E... *\u043C\u0435\u0447\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E*
    \u0425\u043E\u0442\u0435\u043B \u0431\u044B \u044F \u043A\u043E\u0433\u0434\u0430-\u043D\u0438\u0431\u0443\u0434\u044C
    \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
    \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0435.
    \u0427\u0442\u043E\u0431\u044B \u043B\u044E\u0434\u0438 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0435\u043B\u0438 \u0438 \u0445\u0432\u0430\u043B\u0438\u043B\u0438 \u0438\u0437
    \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0438, \u0430 \u0447\u0442\u043E\u0431\u044B...
    \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0432\u043E\u0441\u0445\u0438\u0449\u0430\u043B\u0438\u0441\u044C. \u0427\u0442\u043E\u0431\u044B
    \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430.
    *\u0441\u043C\u0435\u0435\u0442\u0441\u044F* \u0413\u043B\u0443\u043F\u044B\u0435
    \u043C\u0435\u0447\u0442\u044B \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043F\u043E\u0432\u0430\u0440\u0430,
    \u043F\u0440\u0430\u0432\u0434\u0430? \u041B\u0430\u0434\u043D\u043E, \u0445\u0432\u0430\u0442\u0438\u0442
    \u043C\u0435\u0447\u0442\u0430\u0442\u044C - \u043C\u043D\u0435 \u043F\u043E\u0440\u0430
    \u043D\u0430 \u043A\u0443\u0445\u043D\u044E, \u0435\u0434\u0430 \u0441\u0430\u043C\u0430
    \u0441\u0435\u0431\u044F \u043D\u0435 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442!
    *\u0410\u0440\u0442\u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0440\u044B\u0431\u0443
    \u0438 \u0443\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u043A\u0443\u0445\u043D\u044E*"
  children: []
