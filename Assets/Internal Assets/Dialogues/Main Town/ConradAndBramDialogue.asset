  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: 23456789-2345-6789-abcd-ef1234567890
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041A\u0443\u0437\u043D\u0435\u0446 \u0411\u0440\u0430\u043C: - \u041A\u043E\u043D\u0440\u0430\u0434,
    \u0434\u0435\u043B\u043E \u043D\u0435 \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E
    \u043E\u043D \u0434\u0435\u043B\u0430\u043B, \u0430 \u0432 \u0442\u043E\u043C,
    \u043A\u0430\u043A \u043E\u043D \u044D\u0442\u043E \u0434\u0435\u043B\u0430\u043B.
    \u042F \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u0443 \u043D\u0430\u043A\u043E\u0432\u0430\u043B\u044C\u043D\u0438,
    \u0432\u0438\u0436\u0443 \u0432\u0441\u0435\u0445, \u043A\u0442\u043E \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
    \u0438 \u0443\u0445\u043E\u0434\u0438\u0442. \u0411\u0440\u043E\u0434\u044F\u0433\u0430
    \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443.
    \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u2014 \u043D\u0430 \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0438.
    \u0410 \u044D\u0442\u043E\u0442..  \u0412\u0437\u0433\u043B\u044F\u0434 \u0443
    \u043D\u0435\u0433\u043E \u0431\u044B\u043B. \u041E\u043D \u043D\u0435 \u043D\u0430
    \u043B\u044E\u0434\u0435\u0439 \u0441\u043C\u043E\u0442\u0440\u0435\u043B, \u043D\u0435
    \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u044C. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0435\u043B
    \u043D\u0430 \u0434\u043E\u043C\u0430. \u041D\u0430 \u043A\u0440\u044B\u0448\u0438,
    \u043D\u0430 \u043E\u043A\u043D\u0430, \u043D\u0430 \u0437\u0430\u0431\u043E\u0440\u044B.
    \u0421\u043B\u043E\u0432\u043D\u043E \u043F\u0440\u043E \u0441\u0435\u0431\u044F
    \u043E\u0442\u043C\u0435\u0447\u0430\u043B, \u0433\u0434\u0435 \u0434\u043E\u0441\u043A\u0430
    \u0433\u043D\u0438\u043B\u0430\u044F, \u0430 \u0433\u0434\u0435 \u0437\u0430\u0441\u043E\u0432
    \u0445\u043E\u0440\u043E\u0448\u0438\u0439. \u042F \u0442\u0430\u043A \u043D\u0430
    \u0431\u0440\u043E\u043D\u044E \u0441\u043C\u043E\u0442\u0440\u044E, \u043A\u043E\u0433\u0434\u0430
    \u0438\u0449\u0443 \u0441\u043B\u0430\u0431\u043E\u0435 \u043C\u0435\u0441\u0442\u043E.
    \u0411\u0443\u0434\u0442\u043E \u0432\u0437\u0432\u0435\u0448\u0438\u0432\u0430\u043B
    \u0432\u0441\u0435 \u043D\u0430 \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u0445
    \u0432\u0435\u0441\u0430\u0445. \u042D\u0442\u043E \u0432\u0437\u0433\u043B\u044F\u0434
    \u0445\u0438\u0449\u043D\u0438\u043A\u0430, \u041A\u043E\u043D\u0440\u0430\u0434,
    \u0430 \u043D\u0435 \u0433\u043E\u0441\u0442\u044F."
  children:
