  isPlayerSpeaking: 0
  text: "\u0410\u0445, \u0434\u0440\u0443\u0436\u0438\u0449\u0435, \u0431\u0435\u0434\u0430
    \u0443 \u043C\u0435\u043D\u044F! \u041C\u043E\u044F \u043B\u0443\u0447\u0448\u0430\u044F
    \u043C\u0435\u0434\u043E\u0432\u0443\u0445\u0430 \u043F\u0440\u043E\u043F\u0430\u043B\u0430!
    \u0422\u0440\u0438 \u0431\u043E\u0447\u043A\u0438 \u043E\u0442\u0431\u043E\u0440\u043D\u043E\u0433\u043E
    \u043D\u0430\u043F\u0438\u0442\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u044F \u0445\u0440\u0430\u043D\u0438\u043B \u0432 \u043F\u043E\u0434\u0432\u0430\u043B\u0435
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E \u0434\u043B\u044F
    \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0433\u043E \u0434\u043D\u044F..
    \u0412 \u043E\u0431\u0449\u0435\u043C, \u0441\u043F\u0443\u0441\u043A\u0430\u0439\u0441\u044F
    \u0432 \u043F\u043E\u0434\u0432\u0430\u043B \u0438 \u0441\u0430\u043C \u0432\u0441\u0435
    \u0443\u0432\u0438\u0434\u0438\u0448\u044C."
