  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: kuz_root
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u0421\u043B\u0443\u0448\u0430\u0439, \u0443 \u043C\u0435\u043D\u044F \u043A
    \u0442\u0435\u0431\u0435 \u0434\u0435\u043B\u043E. \u0425\u043C\u0435\u043B\u044C
    \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043D\u0435 \u043F\u0440\u0438\u0448\u0451\u043B
    \u2014 \u0430 \u043E\u043D \u0441\u043C\u0435\u043D\u0443 \u043D\u0438 \u0440\u0430\u0437\u0443
    \u043D\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u043B, \u0434\u0430\u0436\u0435
    \u0441 \u0431\u043E\u043B\u044C\u043D\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
    \u044F\u0432\u043B\u044F\u043B\u0441\u044F. \u042F \u0441\u0442\u0443\u0447\u0430\u043B \u043A
    \u043D\u0435\u043C\u0443 \u0434\u043E\u043C\u043E\u0439 \u2014 \u043D\u0435
    \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442."
  children:
  - kuz_p_whathappened
  - kuz_p_iwillcheck
  rect:
    serializedVersion: 2
    x: 100
    y: 100
    width: 200
    height: 100
  onEnterActions: []
  onExitActions: []
  condition:
    _and:
    - _or:
      - _predicate: HasQuest
        _parameters:
        - "\u0417\u043E\u043B\u043E\u0442\u043E"
        _negate: 1
    - _or:
