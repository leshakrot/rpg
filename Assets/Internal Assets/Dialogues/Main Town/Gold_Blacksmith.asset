    \u0434\u043E\u043C. \u0412\u044B\u0439\u0442\u0438 \u043D\u0435 \u043C\u043E\u0436\u0435\u0442,
    \u0434\u0432\u0435\u0440\u044C \u0442\u043E\u0436\u0435
    \u0437\u043E\u043B\u043E\u0442\u0430\u044F. \u0410 \u0435\u0449\u0451 \u0432\u043E\u0442,
    \u043D\u0430\u0448\u0451\u043B \u043D\u0430 \u043B\u0435\u0441\u043D\u043E\u0439
    \u043F\u043E\u043B\u044F\u043D\u0435 \u2014
    \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u0439 \u0437\u043D\u0430\u043A,
    \u043D\u0435 \u043D\u0430\u0448."
