  m_Name: kuz_report_resp
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "*\u0411\u0435\u0440\u0451\u0442 \u0432\u0435\u0449\u0438\u0446\u0443,
    \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442*
    \u041F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437 \u0442\u0430\u043A\u043E\u0435
    \u0432\u0438\u0436\u0443 \u2014 \u043D\u0435 \u043C\u0435\u0441\u0442\u043D\u0430\u044F
    \u0440\u0435\u0437\u044C\u0431\u0430. \u0421\u043B\u0443\u0448\u0430\u0439... \u0412
    \u0433\u043E\u0440\u043E\u0434\u0435 \u043D\u0430
    \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C \u0434\u0432\u043E\u0440\u0435
    \u0432\u0441\u044F\u043A\u0438\u0439 \u043F\u0440\u0438\u0435\u0437\u0436\u0438\u0439
    \u043A\u0443\u043F\u0435\u0446 \u043E\u0431\u044F\u0437\u0430\u043D \u0441\u0432\u043E\u0439
    \u0437\u043D\u0430\u043A \u0443 \u043F\u0438\u0441\u0430\u0440\u044F
    \u043E\u0442\u043C\u0435\u0442\u0438\u0442\u044C, \u0438\u043D\u0430\u0447\u0435
    \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u043D\u0435
    \u0434\u0430\u0434\u0443\u0442. \u0415\u0441\u043B\u0438 \u044D\u0442\u043E\u0442
    \u0442\u0430\u043C \u0437\u0430\u043F\u0438\u0441\u0430\u043D \u2014
    \u0443\u0437\u043D\u0430\u0435\u043C, \u043A\u0442\u043E \u044D\u0442\u043E \u0431\u044B\u043B.
    \u0421\u0445\u043E\u0434\u0438, \u0440\u0430\u0437\u0443\u0437\u043D\u0430\u0439. \u0410 \u044F
    \u043F\u043E\u043A\u0430 \u043F\u043E\u0434\u0443\u043C\u0430\u044E, \u0447\u0442\u043E
    \u0434\u0435\u043B\u0430\u0442\u044C \u0441 \u0425\u043C\u0435\u043B\u0435\u043C."
