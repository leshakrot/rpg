  isPlayerSpeaking: 0
  text: "\u041D\u0435 \u0437\u043D\u0430\u044E. \u041C\u043E\u0436\u0435\u0442,
    \u0441\u043F\u0438\u0442 \u043C\u0435\u0440\u0442\u0432\u0435\u0446\u043A\u0438. \u0410
    \u043C\u043E\u0436\u0435\u0442 \u2014 \u043D\u0435\u0442. \u041D\u0435
    \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u043C\u043D\u0435 \u044D\u0442\u043E.
    \u0421\u0445\u043E\u0434\u0438\u043B \u0431\u044B \u0442\u044B,
    \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B, \u0430? \u041C\u043D\u0435
    \u043E\u0442\u0441\u044E\u0434\u0430 \u043D\u0438\u043A\u0430\u043A \u043D\u0435
    \u043E\u0442\u043E\u0439\u0442\u0438."
  children:
  - kuz_p_iwillcheck
  rect:
    serializedVersion: 2
    x: 700
    y: 0
