--- !u!114 &1000000000000000004
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: herald-explain-01
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E! \u0414\u0432\u0430 \u0438\u0441\
    \u043F\u044B\u0442\u0430\u043D\u0438\u044F. \u041F\u0435\u0440\u0432\u043E\u0435\
    \ \u2014 \u043E\u0445\u043E\u0442\u0430 \u043D\u0430 \u043C\u0438\u0448\u0435\
    \u043D\u0438: \u043A\u0442\u043E-\u0442\u043E \u0435\u0449\u0451 \u0434\u043E\
    \ \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430 \u0441\u043F\u0440\u044F\
    \u0442\u0430\u043B \u0442\u0440\u0438 \u043C\u0438\u0448\u0435\u043D\u0438 \u043F\
    \u043E \u0432\u0441\u0435\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0435. \u041D\
    \u0430\u0439\u0434\u0438 \u0432\u0441\u0435 \u0442\u0440\u0438 \u0438 \u043F\
    \u043E\u0440\u0430\u0437\u0438 \u2014 \u043F\u0435\u0440\u0432\u044B\u0439 \u043F\
    \u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442. \u0412\u0442\u043E\u0440\u043E\
    \u0435 \u2014 \u0431\u0440\u043E\u0441\u043E\u043A \u0431\u0440\u0435\u0432\
    \u043D\u0430: \u043A\u0442\u043E \u0434\u0430\u043B\u044C\u0448\u0435 \u0437\
    \u0430\u0431\u0440\u043E\u0441\u0438\u0442, \u0442\u043E\u0442 \u0438 \u043F\
    \u043E\u0431\u0435\u0434\u0438\u043B. \u041D\u0430\u0433\u0440\u0430\u0434\u0430\
    \ \u2014 \u043E\u0442 \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u043E\
    \u0433\u043E \u043A\u0443\u043F\u0446\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\
    \u0439 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0441\u0435\u0433\u043E\
    \u0434\u043D\u044F \u0443\u0442\u0440\u043E\u043C. \u0413\u043E\u0432\u043E\u0440\
    \u0438\u0442, \u0434\u0430\u0440\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E\
    \ \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\
    \ \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E\u0435. \u041D\u0430\u0447\
    \u0438\u043D\u0430\u0435\u043C?"
  children:
  - herald-start-contest
  rect:
    serializedVersion: 2
    x: 640
    y: 60
    width: 200
    height: 100
  onEnterActions: []
  onExitActions: []
  condition:
    _and: []
