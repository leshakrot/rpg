  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: herald-after-win
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041F\u043E\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C! \u041D\u0430\
    \u0448 \u043A\u0443\u043F\u0435\u0446 \u043E\u0431\u0435\u0449\u0430\u043B \u0432\
    \u0440\u0443\u0447\u0438\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u0443\
    \ \u043B\u0438\u0447\u043D\u043E. \u0418\u0449\u0438 \u0435\u0433\u043E \u0432\
    \u043E\u043D \u0442\u0430\u043C \u2014 \u0443 \u043A\u0440\u0430\u0441\u043D\
    \u043E\u0433\u043E \u0448\u0430\u0442\u0440\u0430. \u0422\u043E\u043B\u044C\u043A\
    \u043E.. \u0441\u0442\u0440\u0430\u043D\u043D\u043E. \u0412 \u0441\u0430\u043C\
    \u043E\u043C \u043D\u0430\u0447\u0430\u043B\u0435 \u043E\u043D \u043F\u0440\u0438\
    \u0448\u0435\u043B \u0438 \u0441\u043F\u0440\u043E\u0441\u0438\u043B, \u043C\
    \u043E\u0436\u043D\u043E \u043B\u0438 \u0443\u0441\u0442\u0440\u043E\u0438\u0442\
    \u044C \u0441\u043E\u0441\u0442\u044F\u0437\u0430\u043D\u0438\u044F. \u0421\u0430\
    \u043C. \u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043D\u0430\u0433\
    \u0440\u0430\u0434\u0443. \u042F \u0442\u043E\u0433\u0434\u0430 \u0435\u0449\
    \u0451 \u043F\u043E\u0434\u0443\u043C\u0430\u043B \u2014 \u043A\u0442\u043E\
    \ \u0436 \u0442\u0430\u043A \u0434\u0435\u043B\u0430\u0435\u0442?"
  children: []
