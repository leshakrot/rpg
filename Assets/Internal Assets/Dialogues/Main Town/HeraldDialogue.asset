  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: herald-start-01
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041D\u0430\u0440\u043E\u0434! \u0421\u043B\u0443\u0448\u0430\u0439,\
    \ \u043D\u0430\u0440\u043E\u0434! \u0422\u0440\u0430\u0434\u0438\u0446\u0438\
    \u043E\u043D\u043D\u044B\u0435 \u0441\u043E\u0441\u0442\u044F\u0437\u0430\u043D\
    \u0438\u044F \u041F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0430 \u0423\u0440\
    \u043E\u0436\u0430\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\
    \u044F! \u041E\u0445\u043E\u0442\u0430 \u043D\u0430 \u0441\u043F\u0440\u044F\
    \u0442\u0430\u043D\u043D\u044B\u0435 \u043C\u0438\u0448\u0435\u043D\u0438, \u0431\
    \u0440\u043E\u0441\u043E\u043A \u0431\u0440\u0435\u0432\u043D\u0430! \u041F\u043E\
    \u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044F \u0436\u0434\u0451\u0442 \u043D\
    \u0430\u0433\u0440\u0430\u0434\u0430 \u0441\u0430\u043C\u043E\u0433\u043E \u043A\
    \u0443\u043F\u0446\u0430! \u041F\u043E\u0434\u0445\u043E\u0434\u0438, \u0435\
    \u0441\u043B\u0438 \u043D\u0435 \u0442\u0440\u0443\u0441\u0438\u0448\u044C!"
  children:
  - herald-player-join
  - herald-player-skip
  rect:
    serializedVersion: 2
    x: 100
    y: 100
    width: 200
    height: 100
  onEnterActions: []
  onExitActions: []
  condition:
    _and:
    - _or:
      - _predicate: HasQuest
        _parameters:
        - "\u0421\u043E\u0441\u0442\u044F\u0437\u0430\u043D\u0438\u0435"
