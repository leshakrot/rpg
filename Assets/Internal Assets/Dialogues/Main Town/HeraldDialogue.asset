  isPlayerSpeaking: 0
  text: "\u0410, \u0432\u043E\u0442 \u0438 \u043D\u0430\u0448 \u043B\u043E\u0432\
    \u043A\u0430\u0447. *\u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F\
    \ \u043D\u0435 \u0433\u043B\u0430\u0437\u0430\u043C\u0438, \u0430 \u0447\u0435\
    \u043C-\u0442\u043E \u0434\u0440\u0443\u0433\u0438\u043C* \u0414\u0435\u0440\
    \u0436\u0438. \u041C\u043E\u043D\u0435\u0442\u0430 \u0443\u0434\u0430\u0447\
    \u0438. \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0435\u0441\u043B\u0438\
    \ \u0437\u0430\u0433\u0430\u0434\u0430\u0442\u044C \u043D\u0430 \u043D\u0435\
    \u0451 \u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u0432 \u043F\u043E\u043B\
    \u043D\u043E\u0447\u044C \u2014 \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\
    \u0441\u044F. \u0425\u043E\u0442\u044F \u044F, \u043A\u043E\u043D\u0435\u0447\
    \u043D\u043E, \u0432 \u0432\u044B\u0434\u0443\u043C\u043A\u0438 \u043D\u0435\
    \ \u0432\u0435\u0440\u044E. *\u0445\u043E\u0445\u043E\u0447\u0435\u0442*"
