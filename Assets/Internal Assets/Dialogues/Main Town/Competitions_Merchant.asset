  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: merch_quest_complete_entry
  m_EditorClassIdentifier: Assembly-CSharp::RPG.Dialogue.DialogueNode
  isPlayerSpeaking: 0
  text: "\u0412\u0441\u0435 \u0442\u0440\u0438! \u042F \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B
    \u0442\u0430\u043A \u0441\u043A\u043E\u0440\u043E. \u041D\u0443 \u0447\u0442\u043E
    \u0436\u0435 \u2014 \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435 \u0435\u0441\u0442\u044C
    \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435. \u0412\u043E\u0437\u044C\u043C\u0438
    \u044D\u0442\u043E \u0437\u0435\u043B\u044C\u0435. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
    \u0442\u043E\u0442, \u043A\u0442\u043E \u0435\u0433\u043E \u0432\u044B\u043F\u044C\u0435\u0442,
    \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0447\u0443\u044F\u0442\u044C
    \u043C\u0438\u0440 \u0438\u043D\u0430\u0447\u0435 \u2014 \u043E\u0441\u0442\u0440\u0435\u0435,
    \u0433\u043B\u0443\u0431\u0436\u0435. \u041C\u043E\u0436\u0435\u0442, \u0438
    \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F."
  children:
  - merch_player_ask_reward
  - merch_player_take_silent
  rect:
