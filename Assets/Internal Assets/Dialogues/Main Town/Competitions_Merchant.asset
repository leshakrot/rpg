  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: merch_farewell
  m_EditorClassIdentifier: Assembly-CSharp::RPG.Dialogue.DialogueNode
  isPlayerSpeaking: 0
  text: "\u041F\u0440\u0438\u044F\u0442\u043D\u043E \u0438\u043C\u0435\u0442\u044C
    \u0434\u0435\u043B\u043E \u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0443\u043C\u0435\u0435\u0442 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u044C
    \u0442\u043E, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E. \u0423\u0432\u0435\u0440\u0435\u043D
    \u2014 \u043C\u044B \u0435\u0449\u0451 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F.
    \u041F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0438 \u2014 \u043E\u043D\u0438
    \u0442\u0430\u043A\u0438\u0435: \u0441\u0432\u043E\u0434\u044F\u0442 \u0432\u043C\u0435\u0441\u0442\u0435
    \u0441\u0430\u043C\u044B\u0445 \u0440\u0430\u0437\u043D\u044B\u0445 \u043B\u044E\u0434\u0435\u0439.
    \u0418 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0434\u0435\u0439."
  children:
  - ca9e47dd-4aaa-4eef-ae56-2dfb680ed930
