  isPlayerSpeaking: 0
  text: "\u0410\u0445 \u0434\u0430, \u044F \u043F\u043E\u043B\u0430\u0433\u0430\u044E,
    \u0447\u0442\u043E \u0432 \u0441\u043A\u043E\u0440\u043E\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438
    \u0442\u0435\u0431\u0435 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F
    \u043C\u043E\u0439 \u043F\u043E\u0434\u0430\u0440\u043E\u043A - \u0443 \u0432\u0430\u0448\u0435\u0433\u043E
    \u043F\u043E\u0432\u0430\u0440\u0430 \u043A\u0442\u043E-\u0442\u043E \u043E\u043F\u044F\u0442\u044C
    \u0441\u0442\u0430\u0449\u0438\u043B \u0435\u0434\u0443 \u0434\u043B\u044F \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0430
    *\u0421\u043C\u0435\u0435\u0442\u0441\u044F*. \u041C\u043E\u0436\u0435\u0448\u044C
    \u0441\u0445\u043E\u0434\u0438\u0442\u044C, \u0440\u0430\u0437\u0443\u0437\u043D\u0430\u0442\u044C."
