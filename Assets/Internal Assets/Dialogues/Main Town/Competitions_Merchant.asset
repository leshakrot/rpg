--- !u!114 &1000000014
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: merch_explain_reward
  m_EditorClassIdentifier: Assembly-CSharp::RPG.Dialogue.DialogueNode
  isPlayerSpeaking: 0
  text: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0440\u0435\u0446\u0435\u043F\u0442.
    \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u043D\u044E\u0445 \u043F\u043E\u0441\u043B\u0435
    \u043D\u0435\u0433\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u043A\u0430\u043A \u0443 \u0437\u0432\u0435\u0440\u044F \u2014 \u0441\u043B\u0435\u0434
    \u0443\u0447\u0443\u0435\u0448\u044C \u0442\u0430\u043C, \u0433\u0434\u0435 \u0434\u0440\u0443\u0433\u043E\u0439
    \u043F\u0440\u043E\u0439\u0434\u0451\u0442 \u043C\u0438\u043C\u043E. \u041D\u0435\u0437\u0430\u043C\u0435\u043D\u0438\u043C\u0430\u044F
    \u0432\u0435\u0449\u044C, \u043A\u043E\u0433\u0434\u0430 \u0438\u0449\u0435\u0448\u044C
    \u0442\u043E, \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u043E\u0447\u0435\u043D\u044C
    \u0441\u0442\u0430\u0440\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0441\u043F\u0440\u044F\u0442\u0430\u043B...
    \u041D\u0443, \u0431\u0435\u0440\u0438 \u0443\u0436\u0435. \u0417\u0430\u0441\u043B\u0443\u0436\u0438\u043B."
  children:
  - merch_player_take_silent
  rect:
    serializedVersion: 2
    x: 648
    y: 749
