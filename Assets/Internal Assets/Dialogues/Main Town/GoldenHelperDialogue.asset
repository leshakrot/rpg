    \u0434\u0435\u0440\u0436\u0443\u0441\u044C \u2014 \u0441\u043E\u0441\u0435\u0434\u0438
    \u0447\u0435\u0440\u0435\u0437 \u0449\u0435\u043B\u044C \u043A\u0443\u0432\u0448\u0438\u043D
    \u0441 \u0432\u043E\u0434\u043E\u0439 \u043F\u0440\u043E\u0441\u043E\u0432\u044B\u0432\u0430\u044E\u0442.
    \u041D\u043E \u0434\u043E\u043B\u0433\u043E \u0442\u0430\u043A \u043D\u0435 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u0442\u044C."
