  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: hmel_p_whatswrong
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 1
  text: "\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C?
    \u0422\u0443\u0442 \u0432\u0441\u0451 \u0437\u043E\u043B\u043E\u0442\u043E\u0435
    \u2014 \u0437\u0430\u0431\u043E\u0440, \u043A\u0440\u044B\u0448\u0430, \u0434\u0432\u0435\u0440\u044C..."
  children:
  - hmel_explain
  rect:
    serializedVersion: 2
