  isPlayerSpeaking: 0
  text: "\u041A\u0442\u043E \u0442\u0430\u043C?.. \u0410, \u044D\u0442\u043E \u0442\u044B.
    \u0425\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E \u0445\u043E\u0442\u044C
    \u043A\u0442\u043E-\u0442\u043E \u043F\u0440\u0438\u0448\u0451\u043B."
  children:
  - hmel_p_whatswrong
  - hmel_p_howareyou
  rect:
    serializedVersion: 2
