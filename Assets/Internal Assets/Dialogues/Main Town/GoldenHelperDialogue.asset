--- !u!114 &3100000004
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: hmel_explain
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041F\u043E\u043C\u043D\u0438\u0448\u044C \u043A\u0443\u043F\u0446\u0430
    \u043D\u0430 \u0441\u043E\u0441\u0442\u044F\u0437\u0430\u043D\u0438\u044F\u0445?
    \u042F \u0432 \u0442\u043E\u0442 \u0434\u0435\u043D\u044C \u0432\u044B\u0438\u0433\u0440\u0430\u043B,
    \u0431\u044B\u043B \u043D\u0430 \u043A\u0443\u0440\u0430\u0436\u0435 \u2014 \u0430
    \u043E\u043D \u0441\u043F\u0440\u043E\u0441\u0438\u043B, \u0447\u0435\u0433\u043E
    \u0431\u044B \u044F \u0445\u043E\u0442\u0435\u043B. \u042F, \u043D\u0435 \u043F\u043E\u0434\u0443\u043C\u0430\u0432,
    \u0431\u0440\u044F\u043A\u043D\u0443\u043B: '\u043E\u0437\u043E\u043B\u043E\u0442\u0438
    \u043C\u0435\u043D\u044F'. \u0412\u043E\u0442 \u043E\u043D \u0438 \u043E\u0437\u043E\u043B\u043E\u0442\u0438\u043B.
    \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u0441\u0451, \u0434\u043E \u0447\u0435\u0433\u043E
    \u0434\u043E\u0442\u0440\u043E\u043D\u0443\u0441\u044C, \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u0437\u043E\u043B\u043E\u0442\u044B\u043C. \u0414\u0430\u0436\u0435 \u0434\u0432\u0435\u0440\u044C."
  children:
  - hmel_p_door
  rect:
    serializedVersion: 2
    x: 700
    y: 100
    width: 200
    height: 100
  onEnterActions: []
  onExitActions: []
  condition:
    _and: []
