  m_Name: finn04-5678-9abc-def1-234567890123
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u0424\u0438\u043D\u043D: - \u041D\u0435 \u0442\u043E \u0441\u043B\u043E\u0432\u043E.
    \u0421\u0442\u0430\u0440\u043E\u0441\u0442\u0430 \u0432\u0435\u043B\u0435\u043B
    \u0443\u043A\u0440\u0430\u0441\u0438\u0442\u044C \u043F\u043B\u043E\u0449\u0430\u0434\u044C,
    \u0438 \u044D\u0442\u043E \u0432\u0441\u0435 \u043A\u0430\u043A \u043E\u0431\u044B\u0447\u043D\u043E
    \u0432 \u0441\u0430\u043C\u044B\u0439 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
    \u043C\u043E\u043C\u0435\u043D\u0442! \u0413\u043E\u0432\u043E\u0440\u0438\u0442
    \u043C\u043D\u0435: \"\u041F\u0440\u043E\u044F\u0432\u0438 \u0444\u0430\u043D\u0442\u0430\u0437\u0438\u044E\".
    \u0410 \u043A\u0430\u043A \u0435\u0435 \u043F\u0440\u043E\u044F\u0432\u0438\u0448\u044C,
    \u0435\u0441\u043B\u0438 \u044D\u0442\u0430 \u0432\u0435\u0440\u0435\u0432\u043A\u0430
    \u0441\u0442\u0430\u0440\u0448\u0435 \u043C\u0435\u043D\u044F \u0440\u0430\u0437
    \u0432 \u0434\u0435\u0441\u044F\u0442\u044C? \u041E\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u043E
    \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432
    \u0442\u0440\u0443\u0445\u0443!"
