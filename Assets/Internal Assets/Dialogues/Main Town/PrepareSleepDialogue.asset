  isPlayerSpeaking: 0
  text: "\u042d\u0442\u043e\u0442 \u043f\u0443\u0442\u043d\u0438\u043a... \u0427\u0442\u043e-\u0442\u043e \u0432 \u043d\u0435\u043c \u043d\u0435 \u0442\u0430\u043a. \u0413\u043e\u0432\u043e\u0440\u0438\u0442, \u043e\u043d \u043f\u043b\u043e\u0442\u043d\u0438\u043a, \u0430 \u0440\u0443\u043a\u0438 \u0433\u043b\u0430\u0434\u043a\u0438\u0435. \u0423\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442, \u0447\u0442\u043e \u0438\u0437 \u043d\u0438\u0437\u0438\u043d\u044b, \u0433\u0434\u0435 \u043b\u0438\u0445\u043e\u0440\u0430\u0434\u043a\u0430, \u043d\u043e \u0432\u044b\u0433\u043b\u044f\u0434\u0438\u0442 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0437\u0434\u043e\u0440\u043e\u0432\u044b\u043c. \u0418 \u043a\u0430\u043a \u043e\u043d \u043e\u0446\u0435\u043d\u0438\u043b \u043f\u043e\u0440\u043e\u0441\u0435\u043d\u043a\u0430... \u0411\u0443\u0434\u0442\u043e \u0432\u0441\u044e \u0436\u0438\u0437\u043d\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u0438 \u0434\u0435\u043b\u0430\u043b, \u0447\u0442\u043e \u0442\u043e\u0440\u0433\u043e\u0432\u0430\u043b. \u041d\u0443\u0436\u043d\u043e \u0434\u0435\u0440\u0436\u0430\u0442\u044c \u0443\u0445\u043e \u0432\u043e\u0441\u0442\u0440\u043e."
