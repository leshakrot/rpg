  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u0422\u044B \u043F\u0440\u0438\u043D\u0451\u0441 \u0434\u043D\u0435\u0432\u043D\u0438\u043A...
    \u0425\u043E\u0440\u043E\u0448\u043E.\n\u042F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E
    \u0447\u0442\u043E-\u0442\u043E \u043D\u0435\u043B\u0430\u0434\u043D\u043E\u0435
    \u0432 \u044D\u0442\u0438\u0445 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430\u0445.\n\u041E\u043D
    \u043F\u0438\u0441\u0430\u043B \u043E \u041F\u043B\u0430\u0449\u0435 \u041D\u0435\u0437\u0440\u0438\u043C\u043E\u0433\u043E
    \u0412\u0435\u0442\u0440\u0430.\n\u0422\u043E\u0442 \u043B\u0435\u0436\u0438\u0442
    \u0432 \u0441\u0443\u043D\u0434\u0443\u043A\u0435 \u043D\u0430 \u0434\u043D\u0435
    \u043E\u0437\u0435\u0440\u0430.\n\u041D\u043E \u0442\u044B \u043E\u0434\u0438\u043D
    \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u043D\u0435\u0448\u044C \u0435\u0433\u043E.\n\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438
    \u0441 \u0440\u044B\u0431\u0430\u043A\u0430\u043C\u0438. \u041E\u043D\u0438 \u0431\u043B\u0438\u0436\u0435
    \u0432\u0441\u0435\u0445 \u043A \u0432\u043E\u0434\u0435."
