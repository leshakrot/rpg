  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: f43463be-4db3-4d49-834e-c5fa15109973
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u0422\u044F\u0436\u043A\u043E \u043C\u043D\u0435 \u0441\u043B\u044B\u0448\u0430\u0442\u044C
    \u0441\u0438\u0435, \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A. \u0413\u0440\u0430\u043C\u043E\u0442\u0430
    \u2014 \u043A\u043B\u0430\u0434\u0435\u0437\u044C \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438,
    \u043A\u043B\u044E\u0447 \u043A \u0442\u0430\u0439\u043D\u0430\u043C \u043C\u0438\u0440\u043E\u0437\u0434\u0430\u043D\u0438\u044F.
    \u041B\u0438\u0448\u044C \u0440\u0430\u0441\u043A\u0440\u043E\u0439 \u0441\u0432\u0438\u0442\u043E\u043A
    \u2014 \u0438 \u0434\u0440\u0435\u0432\u043D\u0438\u0435 \u0440\u0443\u043D\u044B
    \u043F\u043E\u0432\u0435\u0434\u0430\u044E\u0442 \u0442\u0435\u0431\u0435 \u0437\u0430\u043A\u043B\u044F\u0442\u044C\u044F,
