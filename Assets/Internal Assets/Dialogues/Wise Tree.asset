  m_Script: {fileID: 11500000, guid: c648a866d680e7a4b9814c1685013423, type: 3}
  m_Name: f928b6fc-4f27-475f-9925-60dc1b739ad2
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u0412\u0435\u0440\u043D\u043E! \u0410 \u0442\u044B, \u043F\u0430\u0440\u0435\u043D\u044C,
    \u043D\u0435 \u043F\u043E \u0433\u043E\u0434\u0430\u043C \u0443\u043C\u0435\u043D!
    \u0418 \u0432\u043E\u0442, \u0432\u043D\u0438\u043C\u0430\u0439: \u0442\u0440\u0435\u0442\u044C\u044F
    \u0437\u0430\u0433\u0430\u0434\u043A\u0430 \u043C\u043E\u044F, \u0447\u0442\u043E
    \u0441\u043F\u0438\u0442 \u0432 \u0441\u0435\u0440\u0434\u0446\u0435 \u0432\u0435\u043A\u043E\u0432,
    \u0433\u043E\u0442\u043E\u0432\u0430 \u043F\u0440\u043E\u0431\u0443\u0434\u0438\u0442\u044C\u0441\u044F.\r\n\u0421\u043B\u0443\u0448\u0430\u0439
    \u0436\u0435, \u0438\u0431\u043E \u043E\u0442\u0432\u0435\u0442 \u0435\u0451
    \u2014 \u043A\u043B\u044E\u0447 \u043A \u0442\u0430\u0439\u043D\u0430\u043C,
    \u0447\u0442\u043E \u0441\u043A\u0440\u044B\u0442\u044B \u0437\u0430 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u043C\u0438
    \u0437\u043E\u0440\u043A\u043E\u0433\u043E \u043E\u043A\u0430!\xBB"
  children:
  - 0dfacd7c-0875-4f8d-a7aa-bedede1e7830
  rect:
    serializedVersion: 2
    x: 2985
    y: 786
    width: 200
