  m_EditorClassIdentifier: 
  isPlayerSpeaking: 1
  text: "\u041D\u0443 \u0441\u043C\u043E\u0442\u0440\u0438, \u0443 \u043D\u0430\u0441
    2 \u043A\u043E\u0437\u043B\u0430. \u0418 \u043D\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
    \u0438\u043C\u0435\u0435\u0442\u0441\u044F \u0432 \u0432\u0438\u0434\u0443 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435,
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0438\u043B\u0438 \u0432\u0435\u0449\u044C,
    \u043D\u043E \u043B\u0430\u0434\u043D\u043E. \u0414\u0432\u0430. \u0414\u0432\u0430
    \u0433\u043B\u0430\u0437\u0430 \u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
    \u0438 \u0434\u0432\u0430 \u0433\u043B\u0430\u0437\u0430 \u0443 \u043A\u043E\u0437\u043B\u0430,
    \u0430 \u0443 \u043A\u043E\u0437\u043B\u0430-\u0432\u0435\u0449\u0438 \u043D\u0435\u0442
    \u0433\u043B\u0430\u0437, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u0442\u0432\u0435\u0442
    \"2\" \u043E\u0442\u043F\u0430\u0434\u0430\u0435\u0442. \u0422\u044B \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0448\u044C
    - \u0441\u043A\u043E\u043B\u044C\u043A\u043E? \u0421\u043A\u043E\u043B\u044C\u043A\u043E
    \u044D\u0442\u043E \u0447\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435.
    \u0427\u0438\u0441\u043B\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435 - 12
    \u0431\u0443\u043A\u0432, \u043A\u043E\u0437\u043B\u0430 - 2, \u0433\u043B\u0430\u0437\u0430
    \u0442\u043E\u0436\u0435 2, \u0438 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
    \u0442\u0430\u043A\u0436\u0435 2. 12-2-2-2=6. \u0414\u0435\u0440\u0435\u0432\u043E
    - 6 \u0431\u0443\u043A\u0432. \u041E\u0442\u0432\u0435\u0442: \u0414\u0415\u0420\u0415\u0412\u041E.\r\n\u0412\u0441\u0435
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430\u0440\u043D\u043E!"
