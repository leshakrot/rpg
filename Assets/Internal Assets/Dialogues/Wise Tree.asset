  m_Name: 93f72464-43cf-45e4-bbcf-adadcd9564ba
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E \u0442\u0435\u0431\u044F,
    \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A! \u042F \u2014 \u0434\u0440\u0435\u0432\u043E
    \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438, \u0447\u044C\u0438 \u043A\u043E\u0440\u043D\u0438
    \u0443\u0445\u043E\u0434\u044F\u0442 \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0443
