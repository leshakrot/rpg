  m_Name: 030249f7-96ba-4f4c-a72e-530e4d632bf4
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u0412\u0435\u0440\u043D\u043E! \u0410 \u043E\u0442\u0442\u043E\u0433\u043E
    \u0441\u0438\u0434\u0438\u0442 \u043E\u043D, \u0447\u0442\u043E, \u0441\u043B\u043E\u0432\u043D\u043E
    \u0441\u043B\u0435\u043F\u043E\u0439 \u043A\u043E\u0442\u0451\u043D\u043E\u043A,
    \u043D\u0435 \u043F\u043E\u0441\u0442\u0438\u0433 \u043D\u0438 \u0435\u0434\u0438\u043D\u043E\u0439
    \u0438\u0437 \u0442\u0440\u0451\u0445 \u043C\u043E\u0438\u0445 \u0437\u0430\u0433\u0430\u0434\u043E\u043A,
    \u0447\u0442\u043E \u0441\u043F\u044F\u0442 \u0432 \u0441\u0435\u0440\u0434\u0446\u0435\u0432\u0438\u043D\u0435
    \u0432\u0435\u043A\u043E\u0432\u043E\u0433\u043E \u0434\u0443\u0431\u0430.\r\n\u041D\u0435
    \u0440\u0430\u0437\u0433\u0430\u0434\u0430\u043B \u2014 \u0438 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
    \u0432 \u043F\u043B\u0435\u043D\u0443 \u0443 \u043A\u043E\u0440\u043D\u0435\u0439,
    \u0447\u0442\u043E \u0432\u043F\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0432
    \u0437\u0435\u043C\u043B\u044E \u0433\u043B\u0443\u0431\u0436\u0435, \u0447\u0435\u043C
    \u0442\u0430\u0439\u043D\u044B \u043C\u0438\u0440\u043E\u0437\u0434\u0430\u043D\u0438\u044F!\xBB"
