  m_Name: 9db86e0e-d9cb-482c-a115-0126422b5261
  m_EditorClassIdentifier: 
  isPlayerSpeaking: 0
  text: "\u041E, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E \u0442\u0435\u0431\u044F!
    \u0412\u043D\u0435\u043C\u043B\u0438: \u043C\u0438\u043D\u0443\u0432\u0448\u0435\u0433\u043E
    \u043C\u0435\u0441\u044F\u0446\u0430, \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C
    \u043C\u0435\u043B\u044C\u043D\u0438\u043A \u0438\u0441\u0447\u0435\u0437, \u044F
    \u0441\u043B\u0435\u0434\u0438\u043B \u0437\u0430 \u043D\u0438\u043C. \u0412
    \u043E\u0434\u0438\u043D \u0438\u0437 \u0434\u043D\u0435\u0439 \u043E\u043D \u0432\u044B\u0448\u0435\u043B
    \u043A \u043E\u0437\u0435\u0440\u0443, \u0438, \u0442\u0440\u0435\u043F\u0435\u0449\u0430,
    \u043D\u0430\u0447\u0430\u043B \u0432\u043F\u0438\u0441\u044B\u0432\u0430\u0442\u044C
    \u043D\u0435\u0447\u0442\u043E \u0432 \u0441\u0432\u043E\u044E \u043B\u0435\u0442\u043E\u043F\u0438\u0441\u044C.
    \u041C\u043D\u0435 \u0442\u0430\u043A \u043D\u0435 \u0442\u0435\u0440\u043F\u0438\u0442\u0441\u044F
    \u043F\u043E\u0441\u0442\u0438\u0447\u044C, \u0447\u0442\u043E \u043E\u043D \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442!"
  children:
  - ee708201-e78b-49a5-b44a-b3ac2b8cdb0a
  - bf63bdde-d95d-446c-86e0-3d8819956fc5
  - f7691ed3-8808-4631-85b2-e2245d373725
