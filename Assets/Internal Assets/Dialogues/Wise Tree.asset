  text: "\u0425\u043E\u0440\u043E\u0448\u043E, \xAB\u041E\u0434\u0438\u043D \u0432
    \u043F\u043E\u043B\u0435 \u043D\u0435 \u0432\u043E\u0438\u043D\xBB - \u0437\u043D\u0430\u0447\u0438\u0442,
    \u0432\u043E\u0438\u043D - \u0442\u043E, \u0447\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435
    \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u044F. \u0414\u0432\u0430
    \u043F\u043E\u043B\u044F - \u0435\u0449\u0435 \u043D\u0435 \u043B\u0435\u0441,
    \u0430 \u0432\u043E\u0442 \u0441 \u0442\u0440\u0435\u0442\u044C\u0438\u043C -
    \u0443\u0436\u0435 \u043B\u0435\u0441! \u0410 \u0432 \u043B\u0435\u0441\u0443
